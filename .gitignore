.idea/
.DS_Store

# Build output
/dist/

# Lighthouse CI report output (regenerated each run)
/.lighthouseci/

# Go
/retrotech
*.out

# Editor app drafts — local in-progress episodes (content/drafts/*.json),
# auto-saved working state. Published episodes live in content/episodes/.
/content/drafts/

# Migration scratch (reference build snapshot + screenshots; not committed)
/_ref_dist/
/_shots/

# wrangler CLI cache (R2 upload from the editor app)
.wrangler/

# Local research reader executable (not part of public site output)
/.local-bin/
